# Environment variables for AI Engineering Lab
# Copy this to .env and fill in values (do not commit .env)

# Optional: OpenAI API key (used starting Day 7)
# OPENAI_API_KEY=sk-...

# Optional: MongoDB connection string (used starting Day 5)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Optional: AWS credentials (used starting Day 10, optional)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Optional: GCP project and credentials (used starting Day 10, optional)
# GCP_PROJECT_ID=...
# GOOGLE_APPLICATION_CREDENTIALS=...

# Optional: Jira base URL and token (used starting Day 6+, read-only)
# JIRA_BASE_URL=https://your-jira.atlassian.net
# JIRA_API_TOKEN=...

# Optional: Zowe connection (used starting Day 6+, synthetic records only)
# ZOWE_HOST=...
# ZOWE_PORT=443
# ZOWE_USER=...
